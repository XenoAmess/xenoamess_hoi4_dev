    "source_code": "import hashlib,json,re,subprocess,sys,time\nfrom pathlib import Path\nimport requests\nsys.path.insert(0,str(Path(__file__).resolve().parents[1]))\nfrom tools.common import ROOT,read_json,write_json,file_sha256,machine_id,utc_now\ncommit,batch=sys.argv[1:3];assert re.fullmatch('[0-9a-f]{40}',commit) and re.fullmatch('[A-Za-z0-9-]+',batch)\nreceipt=read_json(ROOT/f'runtime/low-scoped-checkpoints/{batch}/receipt.json');assert receipt['commit']==commit\npublication=ROOT/f'runtime/checkpoint-{batch}.json';pub=read_json(publication);assert pub['commit']==commit and pub.get('pushed_at_utc')\nindex=json.loads(subprocess.check_output(['git','show',commit+':mod_nailong/data/fullsize-files.json'],cwd=ROOT))\npaths=[p for p in receipt['paths'] if p.startswith('mod_nailong/assets/generated_fullsize/') and p.endswith('.png')]\nassert len(paths)==receipt['new_original_PNGs'] and 1<=len(paths)<=64\nout=ROOT/f'runtime/scoped-original-readbacks/{batch}.json';previous=read_json(out) if out.exists() else None\nif previous:\n assert previous['machine_id']==machine_id() and previous['commit']==commit and previous['status']=='reading_exact_new_originals'\n archive=ROOT/f'runtime/scoped-original-readbacks/{batch}-terminal-phase1-preserved.json';assert not archive.exists();write_json(archive,previous)\nproof={'machine_id':machine_id(),'commit':commit,'batch':batch,'started_at_utc':utc_now(),'status':'reading_exact_new_originals','complete_archive_verified':False,'new_originals_expected':len(paths),'outputs':dict(previous['outputs']) if previous else {},'prior_actual_terminal_phase_preserved':bool(previous),'source_code':Path(__file__).read_text(encoding='utf-8'),'scope':'Isolated bounded read-only download of this exact immutable snapshot new PNGs only. No full-library scan, shared checkpoint/cache mutation, Git write, lock deletion, image call, TLS/proxy change or claim that unrelated original files were freshly read. Existing global full-library reader is untouched.'};write_json(out,proof)\nfor path in paths:\n digest=Path(path).stem;assert re.fullmatch('[0-9a-f]{64}',digest);e=index['outputs'][digest];assert e['path']==path\n blob=subprocess.check_output(['git','rev-parse',commit+':'+path],cwd=ROOT,text=True).strip()\n if digest in proof['outputs']:\n  v=proof['outputs'][digest];assert v['path']==path and v['bytes']==e['bytes'] and v['sha256']==digest and v['git_blob_sha1']==blob and v['readback_commit']==commit\n  continue\n url='https://raw.githubusercontent.com/XenoAmess/xenoamess_hoi4_dev/'+commit+'/'+path\n for attempt in range(3):\n  try:\n   h=hashlib.sha256();size=0\n   with requests.get(url,stream=True,timeout=(15,90)) as response:\n    response.raise_for_status()\n    for block in response.iter_content(1048576):\n     size+=len(block);assert size<=e['bytes'];h.update(block)\n   assert size==e['bytes'] and h.hexdigest()==digest\n   break\n  except requests.RequestException as error:\n   if isinstance(error,requests.HTTPError):raise\n   if attempt==2:raise\n   time.sleep(2**attempt)\n proof['outputs'][digest]={'path':path,'bytes':size,'sha256':digest,'git_blob_sha1':blob,'url':url,'readback_commit':commit,'verified_at_utc':utc_now(),'method':'Complete anonymous raw PNG download; SHA256 and byte count'};write_json(out,proof)\nproof.update(status='verified_new_originals',completed_at_utc=utc_now(),new_originals_verified=len(paths),new_original_bytes_verified=sum(e['bytes'] for e in proof['outputs'].values()));write_json(out,proof)\npub.update(status='committed_pushed_and_new_originals_verified',completed_at_utc=utc_now(),new_originals_remote_readback=out.relative_to(ROOT).as_posix(),complete_archive_fresh_readback_claimed=False);write_json(publication,pub)\nprint(json.dumps({'status':proof['status'],'commit':commit,'new_originals':len(paths),'bytes':proof['new_original_bytes_verified']}))\n",
