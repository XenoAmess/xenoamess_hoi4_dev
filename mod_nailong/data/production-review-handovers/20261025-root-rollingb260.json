    "source": "\"\"\"Count a normally completed root b group and preserve its exact evidence.\"\"\"\nimport json,re,sys\nfrom pathlib import Path\nsys.path.insert(0,str(Path(__file__).resolve().parents[1]))\nfrom tools.common import ROOT,read_json,write_json,file_sha256,machine_id,utc_now\ntag=sys.argv[1];assert re.fullmatch(r'rollingb[0-9]+',tag)\nreceipt=ROOT/f'mod_nailong/data/production-review-slot-completions/{tag}.json';done=read_json(receipt)\nassert done['status']=='reviewed_and_staged' and done['machine_id']==machine_id()\nreport=ROOT/done['report'];body=read_json(report);assert file_sha256(report)==done['report_sha256']\nslot=read_json(ROOT/'runtime/rolling-review-queue/slot-b.json');assert slot['status']=='available' and slot['last_report']==done['report']\nphase_path=ROOT/'runtime/root-b-review-v37-phase.json';phase=read_json(phase_path);assert phase['current_tag']==tag and phase['current_kind']=='portrait' and phase['completed_groups']<phase['max_groups']\ntarget=ROOT/f'mod_nailong/data/production-review-handovers/20261025-root-{tag}.json';assert not target.exists()\nproof=ROOT/f'runtime/root-review-slot-b/{tag}/verified-binding.json';config=ROOT/done['config']\nphase['completed_groups']+=1;phase.update(current_tag=None,current_kind=None,updated_at_utc=utc_now())\nphase.setdefault('completed',[]).append({'tag':tag,'report':done['report'],'report_sha256':file_sha256(report),'completed_at_utc':done['completed_at_utc']})\ndetail=proof.parent/'actual-detail-crops.json'\nwrite_json(target,{'machine_id':machine_id(),'observed_at_utc':utc_now(),'operator':'Codex root in existing b slot; b agent stopped','report':done['report'],'report_sha256':file_sha256(report),'counts':body['counts'],'slot_completion':receipt.relative_to(ROOT).as_posix(),'slot_completion_sha256':file_sha256(receipt),'actual_review_config':read_json(config),'config_sha256':file_sha256(config),'independent_ordered_builtin_binding':read_json(proof),'binding_proof_sha256':file_sha256(proof),'targeted_actual_pixel_details':read_json(detail) if detail.exists() else [],'finite_phase_after_completion':phase,'finalizer_source':{'path':Path(__file__).relative_to(ROOT).as_posix(),'sha256':file_sha256(Path(__file__)),'source':Path(__file__).read_text(encoding='utf-8')},'scope':'Actual root observations/decisions, no automatic approval or new slot. Stage/global/complete already succeeded once. Sole running builtin producer applies decisions between imports; all original/raw PNGs remain unchanged.'})\nwrite_json(phase_path,phase)\nprint(json.dumps({'tag':tag,'counts':body['counts'],'completed_groups':phase['completed_groups'],'audit':target.relative_to(ROOT).as_posix()},ensure_ascii=True))\n"
  },
  "scope": "Actual root observations/decisions, no automatic approval or new slot. Stage/global/complete already succeeded once. Sole running builtin producer applies decisions between imports; all original/raw PNGs remain unchanged."
