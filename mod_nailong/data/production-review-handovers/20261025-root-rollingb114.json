    "source": "import sys,json\nfrom pathlib import Path\nfrom PIL import Image\nsys.path.insert(0,str(Path(__file__).resolve().parents[1]))\nfrom tools.common import ROOT,read_json,write_json,file_sha256,machine_id,utc_now\nfolder=ROOT/'runtime/root-review-slot-b/rollingb114';proof=read_json(folder/'verified-binding.json');target=folder/'actual-detail-crops.json';assert not target.exists();rows=[]\nfor index,box,name in [(1,[350,640,830,1050],'1-neck-review-only.png'),(4,[275,470,580,710],'4-face-review-only.png')]:\n e=next(e for e in proof['entries'] if e['index']==index);p=ROOT/e['generated_fullsize_image'];assert file_sha256(p)==e['generated_fullsize_sha256'];path=folder/name;assert not path.exists()\n with Image.open(p) as im:im.crop(box).save(path)\n rows.append({'index':index,'input':p.relative_to(ROOT).as_posix(),'input_sha256':file_sha256(p),'crop_box':box,'review_only_output':path.relative_to(ROOT).as_posix(),'review_only_output_sha256':file_sha256(path),'scope':'Actual pixel crop for observation only, no production edit or approval.'})\nwrite_json(target,{'machine_id':machine_id(),'created_at_utc':utc_now(),'crops':rows,'source':Path(__file__).read_text(encoding='utf-8')});print(json.dumps(rows),flush=True)\n"
