    "source": "\"\"\"Finish the root b finite-group bookkeeping after actual source completion.\"\"\"\nimport json,re,sys\nfrom pathlib import Path\nsys.path.insert(0,str(Path(__file__).resolve().parents[1]))\nfrom tools.common import ROOT,read_json,write_json,file_sha256,machine_id,utc_now\ntag=sys.argv[1]\nassert re.fullmatch(r'fresh-observed-20261025T[0-9]{6}-b-[0-9a-f]{8}',tag)\nphase_path=ROOT/'runtime/root-b-review-v12-phase.json';phase=read_json(phase_path)\nassert phase['machine_id']==machine_id() and phase['current_kind']=='originals' and phase['current_tag']==tag\nassert phase['completed_groups']<phase['max_groups']\nreceipt=ROOT/f'mod_nailong/data/production-fresh-observation-completions/{tag}.json';done=read_json(receipt)\nassert done['machine_id']==machine_id() and done['slot']=='b' and done['queued_originals']==4 and done['held_originals']==0\nassert done['image_calls']==0 and done['quota_claims']==0\nobservations=ROOT/done['observations'];assert file_sha256(observations)==done['observations_sha256']\ntarget=ROOT/f'mod_nailong/data/production-review-handovers/20261025-root-{tag}.json';assert not target.exists()\nphase['completed_groups']+=1;phase.update(current_tag=None,current_kind=None,updated_at_utc=utc_now())\nphase.setdefault('completed',[]).append({'tag':tag,'kind':'originals','completion':receipt.relative_to(ROOT).as_posix(),'completion_sha256':file_sha256(receipt),'completed_at_utc':done['completed_at_utc']})\nwrite_json(target,{'machine_id':machine_id(),'observed_at_utc':utc_now(),'operator':'Codex root in existing b slot; b agent stopped','completion':done,'completion_sha256':file_sha256(receipt),'actual_source_observations':read_json(observations),'finite_phase_after_completion':phase,'finalizer_source':{'path':Path(__file__).relative_to(ROOT).as_posix(),'sha256':file_sha256(Path(__file__)),'source':Path(__file__).read_text(encoding='utf-8')},'scope':'Source observation completion already succeeded once. Only finite root b phase bookkeeping is updated here; no art approval, image call, retry or canonical portrait mutation.'})\nwrite_json(phase_path,phase)\nprint(json.dumps({'tag':tag,'completed_groups':phase['completed_groups'],'audit':target.relative_to(ROOT).as_posix()},ensure_ascii=True))\n"
