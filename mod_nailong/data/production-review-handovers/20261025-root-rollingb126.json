geted_actual_pixel_details':read_json(detail) if detail.exists() else [],'finite_phase_after_completion':phase,'finalizer_source':{'path':Path(__file__).relative_to(ROOT).as_posix(),'sha256':file_sha256(Path(__file__)),'source':Path(__file__).read_text(encoding='utf-8')},'scope':'Actual root observations/decisions, no automatic approval or new slot. Stage/global/complete already succeeded once. Sole running builtin producer applies decisions between imports; all original/raw PNGs remain unchanged.'})\nwrite_json(phase_path,phase)\nprint(json.dumps({'tag':tag,'counts':body['counts'],'completed_groups':phase['completed_groups'],'audit':target.relative_to(ROOT).as_posix()},ensure_ascii=True))\n"
