  "source_code": "\"\"\"Preserve failure, then independently validate the exact isolated rebase tree.\"\"\"\nimport hashlib,io,json,subprocess,sys\nfrom pathlib import Path\nfrom PIL import Image\nsys.path.insert(0,str(Path(__file__).resolve().parents[1]))\nfrom tools.common import ROOT,read_json,write_json,file_sha256,machine_id,utc_now\nold='e59a09b9f939afae28e718f2cca3d53728ffd45b';candidate='7adf580d30afbddff0735cf5f3c39ebbc90a5968';parent='d2bd73ef48ecad7cf491326c6e366aa09c2a89b9';remote='975d79b8513ea1f3d4d87e201d4978115b1bea00';batch='resumed-low-v7-auto-2-20261025'\ndef git(*args):\n r=subprocess.run(['git','-c','gc.auto=0',*args],cwd=ROOT,capture_output=True);assert r.returncode==0,(args,r.stderr.decode('utf-8','replace'));return r.stdout\ndef save_file(path):\n p=ROOT/path;b=p.read_bytes();return {'path':path,'sha256':hashlib.sha256(b).hexdigest(),'actual_utf8_bytes_as_text':b.decode('utf-8')}\nfailure=ROOT/'mod_nailong/data/production-checkpoint-failures/20261025-v7-auto2-remote-rebase.json';assert not failure.exists()\npaths=[f'runtime/checkpoint-{batch}.json',f'runtime/production-sync/{batch}-network-1-e59a09b9f939-receipt.json','runtime/resume-low-20261025/publisher-resume-20261025-large-logical-queue-v7.json']\nwrite_json(failure,{'machine_id':machine_id(),'observed_at_utc':utc_now(),'status':'original_failure_preserved_before_revalidation_or_retry','original_commit':old,'isolated_rebased_candidate':candidate,'actual_files':[save_file(p) for p in paths],'primary_HEAD_at_preservation':git('rev-parse','HEAD').decode().strip(),'primary_cached_changes':git('diff','--cached','--name-only').decode(),'source_code':Path(__file__).read_text(encoding='utf-8'),'scope':'Automatic publisher stopped before push because remote advancement changed the isolated rebase commit. Preserve all original receipts/errors. No image replay, PNG mutation, public-history rewrite or working-file change.'})\ndef tree(commit):\n result={}\n for entry in git('ls-tree','-rz','--full-tree',commit).split(b'\\0'):\n  if not entry:continue\n  meta,name=entry.split(b'\\t',1);mode,kind,oid=meta.decode().split();result[name.decode('utf-8')]=(mode,kind,oid)\n return result\nold_parent=tree(parent);old_tree=tree(old);remote_tree=tree(remote);new_tree=tree(candidate)\nown={p for p in old_parent.keys()|old_tree.keys() if old_parent.get(p)!=old_tree.get(p)}\nforeign={p for p in old_parent.keys()|remote_tree.keys() if old_parent.get(p)!=remote_tree.get(p)}\nassert own and foreign and not own&foreign,'Overlapping remote/task edits require explicit file-level reconciliation'\nassert git('rev-parse',old+'^').decode().strip()==parent\nassert git('rev-parse',candidate+'^').decode().strip()==remote\nexpected=dict(remote_tree)\nfor p in own:\n if p in old_tree:expected[p]=old_tree[p]\n else:expected.pop(p,None)\nassert new_tree==expected,'Rebased tree differs from exact original task patch over complete remote tree'\nreceipt=read_json(ROOT/f'runtime/checkpoint-{batch}.json');assert set(receipt['paths'])==own\njson_count=0;masters=[]\nfor p in sorted(own):\n if p not in new_tree:continue\n mode,kind,oid=new_tree[p];assert kind=='blob' and mode=='100644'\n if p.endswith('.json'):json.loads(git('cat-file','blob',oid));json_count+=1\n if p.startswith('mod_nailong/assets/generated_fullsize/') and p.endswith('.png'):\n  b=git('cat-file','blob',oid);sha=hashlib.sha256(b).hexdigest();assert Path(p).stem==sha and b[:8]==b'\\x89PNG\\r\\n\\x1a\\n'\n  assert file_sha256(ROOT/p)==sha and (ROOT/p).stat().st_size==len(b)\n  with Image.open(io.BytesIO(b)) as im:assert im.format=='PNG';im.verify()\n  masters.append({'path':p,'git_blob':oid,'sha256':sha,'bytes':len(b),'ordinary_blob':True,'local_original_identical':True})\nassert len(masters)==receipt['new_original_PNGs']==15\nassert sum(p['bytes'] for p in masters)==receipt['new_original_bytes']\ngit('diff','--check',remote,candidate)\nproof=ROOT/'mod_nailong/data/production-checkpoint-failures/20261025-v7-auto2-rebase-validation.json';assert not proof.exists()\nwrite_json(proof,{'machine_id':machine_id(),'verified_at_utc':utc_now(),'original_failure':failure.relative_to(ROOT).as_posix(),'original_failure_sha256':file_sha256(failure),'original_parent':parent,'original_private_commit':old,'remote_parent':remote,'validated_candidate':candidate,'original_task_changed_paths':sorted(own),'remote_changed_paths':sorted(foreign),'overlap':[],'entire_candidate_tree_exact_original_task_patch_over_remote':True,'task_paths_identical_mode_type_blob':True,'all_remote_paths_preserved':True,'valid_task_JSONs':json_count,'validated_original_PNGs':masters,'validated_original_bytes':sum(p['bytes'] for p in masters),'validation_script_source':Path(__file__).read_text(encoding='utf-8'),'scope':'Read-only fresh complete tree and exact15 ordinary PNG blob validation. Candidate is newly validated after actual isolated rebase, not a claim it was unchanged or published/read back. Original failed checkpoint remains untouched. No working-file/index/ref/image mutation.'})\nprint(json.dumps({'validation':proof.relative_to(ROOT).as_posix(),'candidate':candidate,'own_paths':len(own),'remote_paths':len(foreign),'overlap':0,'ordinary_PNGs':len(masters),'PNG_bytes':sum(x['bytes'] for x in masters),'valid_JSONs':json_count,'published':False},ensure_ascii=True))\n",
